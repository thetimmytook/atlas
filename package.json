{
  "name": "atlas",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "build": "npm run typecheck && vite build",
    "dev": "vite",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tooling.json --noEmit && tsc -p tsconfig.tests.json --noEmit && tsc -p tsconfig.examples.json --noEmit",
    "test": "vitest run",
    "typecheck:watch": "tsc --noEmit --watch --preserveWatchOutput",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check",
    "bench:build": "vite build --config benchmark.config.mts",
    "bench:preview": "vite preview --config benchmark.config.mts",
    "bench:dev": "vite --config benchmark.config.mts"
  },
  "lint-staged": {
    "*.{ts,mts,js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,jsonc,css,html,md,yml,yaml}": "prettier --write"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@microsoft/api-extractor": "^7.59.3",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/eslint-plugin-security": "^3.0.1",
    "@types/node": "^20.19.43",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-sonarjs": "^4.2.1",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.1",
    "vite-plugin-dts": "^5.1.1",
    "vitest": "^4.1.11"
  },
  "imports": {
    "#camera/*.js": "./src/camera/*.ts",
    "#components/*.js": "./src/components/*.ts",
    "#definitions/*.js": "./src/definitions/*.ts",
    "#errors/*.js": "./src/errors/*.ts",
    "#interaction/*.js": "./src/interaction/*.ts",
    "#math/*.js": "./src/math/*.ts",
    "#renderers/*.js": "./src/renderers/*.ts",
    "#validators/*.js": "./src/validators/*.ts",
    "#objects/*.js": "./src/objects/*.ts",
    "#spatial/*.js": "./src/spatial/*.ts"
  }
}
